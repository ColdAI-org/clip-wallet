// services/media-proxy — fetches untrusted NFT media for the wallet UI. NOT DEPLOYED.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clip-wallet-media-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "observability": { "enabled": false },
  "vars": {
    "IPFS_GATEWAY": "https://ipfs.io",
    "ARWEAVE_GATEWAY": "https://arweave.net"
  },
  // Per-client-IP limit (period must be 10 or 60 s). namespace_id is a placeholder: pick one unique to the account.
  "ratelimits": [{ "name": "MEDIA_LIMITER", "namespace_id": "4201", "simple": { "limit": 300, "period": 60 } }]
}
