// services/backup — passkey-encrypted backup blobs + email sign-in.
// Deployed (testnet builds) to https://clip-backup.<subdomain>.workers.dev; see docs/phase25/deploy.md.
// Secrets (never in this file): EMAIL_PEPPER (set), RESEND_API_KEY (unset = email sign-in off, 503).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clip-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clip-backup-db",
      "database_id": "713055ac-b7e8-4eab-ba73-86ec4538ae6b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "clip-backup-blobs" }],
  "vars": {
    // Where the sign-in link points; the wallet reads `token` from the fragment (never sent to a server).
    "APP_URL": "https://wallet.example/backup",
    // Browser origins allowed to call the API (comma-separated), e.g. chrome-extension://<id>.
    "ALLOWED_ORIGINS": "",
    // Sender for sign-in links (domain verified in Resend). Email stays off until RESEND_API_KEY is also set.
    "EMAIL_FROM": ""
  },
  // Hourly cleanup of expired links, sessions and rate-limit windows.
  "triggers": { "crons": ["17 * * * *"] }
}
