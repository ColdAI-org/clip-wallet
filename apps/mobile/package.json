{
  "name": "@clip-wallet/mobile",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/apps/mobile#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "apps/mobile"
  },
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "pnpm --filter @clip-wallet/mobile-kit inpage && NODE_OPTIONS=--conditions=development expo start --dev-client",
    "ios": "pnpm --filter @clip-wallet/mobile-kit inpage && NODE_OPTIONS=--conditions=development expo run:ios",
    "android": "pnpm --filter @clip-wallet/mobile-kit inpage && NODE_OPTIONS=--conditions=development expo run:android",
    "prebuild": "NODE_OPTIONS=--conditions=development expo prebuild --clean",
    "export:ios": "pnpm --filter @clip-wallet/mobile-kit inpage && NODE_OPTIONS=--conditions=development expo export --platform ios --output-dir dist",
    "export:android": "pnpm --filter @clip-wallet/mobile-kit inpage && NODE_OPTIONS=--conditions=development expo export --platform android --output-dir dist",
    "config": "NODE_OPTIONS=--conditions=development expo config --type public",
    "dapp": "node scripts/serve-test-dapp.mjs",
    "typecheck": "pnpm --filter @clip-wallet/mobile-kit inpage && tsc -p . --noEmit",
    "test": "echo \"apps/mobile: tests live in packages/mobile-kit\""
  },
  "dependencies": {
    "@clip-wallet/config": "workspace:*",
    "@clip-wallet/mobile-kit": "workspace:*",
    "@ledgerhq/react-native-hw-transport-ble": "6.41.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@walletconnect/react-native-compat": "2.25.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-background-task": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-argon2": "4.0.0",
    "react-native-ble-plx": "3.4.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-passkey": "3.6.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "typescript": "^5.9.3"
  }
}
