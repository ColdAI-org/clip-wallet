{
  "name": "@clip-wallet/mobile",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "inpage": "node scripts/build-inpage.mjs",
    "start": "node scripts/build-inpage.mjs && expo start --dev-client",
    "ios": "node scripts/build-inpage.mjs && expo run:ios",
    "android": "node scripts/build-inpage.mjs && expo run:android",
    "prebuild": "expo prebuild --clean",
    "export:ios": "node scripts/build-inpage.mjs && expo export --platform ios --output-dir dist",
    "dapp": "node scripts/serve-test-dapp.mjs",
    "typecheck": "node scripts/build-inpage.mjs && tsc -p . --noEmit",
    "test": "node scripts/build-inpage.mjs && vitest run && jest"
  },
  "dependencies": {
    "@clip-wallet/1mask": "workspace:*",
    "@clip-wallet/config": "workspace:*",
    "@clip-wallet/core": "workspace:*",
    "@clip-wallet/engine": "workspace:*",
    "@clip-wallet/ui": "workspace:*",
    "@clip-wallet/vault": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@walletconnect/react-native-compat": "2.25.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-argon2": "4.0.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-passkey": "3.6.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "^5.9.3",
    "@react-native/jest-preset": "0.86.3",
    "react-test-renderer": "19.2.3",
    "vitest": "^2.1.9",
    "happy-dom": "^20.14.5"
  }
}
