{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": false,
    // Type-check workspace packages against their TypeScript source ("development").
    "customConditions": ["development"],
    "types": ["node"]
  },
  // The kit's ambient declarations (pako) for its TypeScript source.
  "include": ["index.ts", "app.config.ts", "clip.config.ts", "../../packages/mobile-kit/src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "ios", "android"]
}
