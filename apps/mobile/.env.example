# Copy to .env (never commit .env). All optional.
# Reown (WalletConnect) project id from https://dashboard.reown.com. Without it, WalletConnect is switched off.
EXPO_PUBLIC_WC_PROJECT_ID=
# Passkey relying party (a domain you own with webcredentials set up). Without it, passkeys are offered as unavailable
# and Face ID / Touch ID unlock uses the device key instead.
EXPO_PUBLIC_PASSKEY_RP_ID=
# Domain for universal links + webcredentials (adds associated domains at prebuild).
CLIP_ASSOCIATED_DOMAIN=
