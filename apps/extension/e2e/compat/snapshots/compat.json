{
  "wagmi": {
    "steps": {
      "discover": {
        "ok": {
          "id": "org.coldai.clipwallet",
          "name": "Clip Wallet",
          "type": "injected",
          "hasIcon": true
        }
      },
      "connect": {
        "ok": {
          "accounts": 1,
          "chainId": 11155111
        }
      },
      "sign": {
        "ok": {
          "valid": true
        }
      },
      "send": {
        "ok": {
          "error": "TransactionExecutionError",
          "code": 4001
        }
      }
    },
    "wire": {
      "requests": [
        "{\"family\":\"evm\",\"method\":\"1mask_getProviderState\",\"result\":{\"accounts\":[],\"chainId\":\"0x4cef52\",\"isUnlocked\":\"boolean\",\"networkVersion\":\"5042002\"}}",
        "{\"family\":\"evm\",\"method\":\"eth_accounts\",\"result\":[\"<evm-address>\"]}",
        "{\"family\":\"evm\",\"method\":\"eth_accounts\",\"result\":[]}",
        "{\"family\":\"evm\",\"method\":\"eth_chainId\",\"result\":\"0xaa36a7\"}",
        "{\"family\":\"evm\",\"method\":\"eth_sendTransaction\",\"error\":{\"code\":4001}}",
        "{\"family\":\"evm\",\"method\":\"personal_sign\",\"result\":\"<hex 65 bytes>\"}",
        "{\"family\":\"evm\",\"method\":\"wallet_requestPermissions\",\"result\":[{\"caveats\":[{\"type\":\"restrictReturnedAccounts\",\"value\":[\"<evm-address>\"]}],\"date\":\"<timestamp>\",\"id\":\"https://compat-dapp.example#eth_accounts\",\"invoker\":\"https://compat-dapp.example\",\"parentCapability\":\"eth_accounts\"}]}"
      ],
      "events": [
        "{\"family\":\"evm\",\"event\":\"accountsChanged\",\"data\":[\"<evm-address>\"]}"
      ]
    }
  },
  "solana": {
    "steps": {
      "detect": {
        "ok": {
          "name": "Clip Wallet",
          "readyState": "Installed",
          "supportedTransactionVersions": [
            0,
            "legacy"
          ]
        }
      },
      "connect": {
        "ok": {
          "connected": true,
          "publicKey": "base58"
        }
      },
      "signMessage": {
        "ok": {
          "bytes": 64
        }
      }
    },
    "wire": {
      "requests": [
        "{\"family\":\"evm\",\"method\":\"1mask_getProviderState\",\"result\":{\"accounts\":[],\"chainId\":\"0x4cef52\",\"isUnlocked\":\"boolean\",\"networkVersion\":\"5042002\"}}",
        "{\"family\":\"solana\",\"method\":\"solana:signMessage\",\"result\":[{\"signature\":\"<base64>\",\"signedMessage\":\"SGVsbG8gZnJvbSBhbiB1bm1vZGlmaWVkIFNvbGFuYSBkYXBw\"}]}",
        "{\"family\":\"solana\",\"method\":\"standard:connect\",\"result\":[{\"address\":\"<base58>\",\"publicKey\":\"<base64>\"}]}"
      ],
      "events": [
        "{\"family\":\"solana\",\"event\":\"accountsChanged\",\"data\":[{\"address\":\"<base58>\",\"publicKey\":\"<base64>\"}]}"
      ]
    }
  },
  "sui": {
