{
  "name": "@clip-wallet/extension",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:fixtures": "CLIP_MOCKS=1 wxt build",
    "zip": "wxt zip",
    "package": "node scripts/package.mjs",
    "store:shots": "CLIP_MOCKS=1 wxt build && STORE_SHOTS=1 playwright test e2e/store.spec.ts",
    "typecheck": "wxt prepare && tsc -p . --noEmit",
    "test": "vitest run",
    "e2e": "wxt build && CLIP_MOCKS=1 wxt build && playwright test"
  },
  "dependencies": {
    "@clip-wallet/1mask": "workspace:*",
    "@clip-wallet/backup-client": "workspace:*",
    "@clip-wallet/chains-algorand": "workspace:*",
    "@clip-wallet/chains-aptos": "workspace:*",
    "@clip-wallet/chains-bitcoin": "workspace:*",
    "@clip-wallet/chains-cardano": "workspace:*",
    "@clip-wallet/chains-evm": "workspace:*",
    "@clip-wallet/chains-hedera": "workspace:*",
    "@clip-wallet/chains-near": "workspace:*",
    "@clip-wallet/chains-solana": "workspace:*",
    "@clip-wallet/chains-starknet": "workspace:*",
    "@clip-wallet/chains-stellar": "workspace:*",
    "@clip-wallet/chains-substrate": "workspace:*",
    "@clip-wallet/chains-sui": "workspace:*",
    "@clip-wallet/chains-tezos": "workspace:*",
    "@clip-wallet/chains-ton": "workspace:*",
    "@clip-wallet/config": "workspace:*",
    "@clip-wallet/core": "workspace:*",
    "@clip-wallet/engine": "workspace:*",
    "@clip-wallet/features": "workspace:*",
    "@clip-wallet/hardware": "workspace:*",
    "@clip-wallet/i18n": "workspace:*",
    "@clip-wallet/kit-modules": "workspace:*",
    "@clip-wallet/link": "workspace:*",
    "@clip-wallet/names": "workspace:*",
    "@clip-wallet/plugins": "workspace:*",
    "@clip-wallet/route": "workspace:*",
    "@clip-wallet/security": "workspace:*",
    "@clip-wallet/social": "workspace:*",
    "@clip-wallet/ui": "workspace:*",
    "@clip-wallet/vault": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "buffer": "^6.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mysten/wallet-standard": "^0.21.32",
