    "@mysten/sui": "^2.34.0",
    "@mysten/wallet-standard": "^0.21.32",
    "@near-js/crypto": "^2.5.1",
    "@near-js/providers": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@near-wallet-selector/core": "^10.1.4",
    "@playwright/test": "^1.63.0",
    "@polkadot/api": "17.0.2",
    "@polkadot/extension-dapp": "^0.64.1",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@scure/base": "2.2.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-standard-util": "^1.1.4",
