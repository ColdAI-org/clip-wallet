{
  "name": "@clip-wallet/desktop",
  "productName": "Clip Wallet",
  "version": "0.1.0",
  "description": "Clip Wallet for macOS, Windows and Linux, with a built-in dapp browser. Test networks only.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/apps/desktop#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "apps/desktop"
  },
  "private": true,
  "author": "ColdAI <shayan@coldai.org>",
  "type": "module",
  "main": "out/main/index.mjs",
  "scripts": {
    "build": "pnpm --filter @clip-wallet/desktop-kit inpage && NODE_OPTIONS=--conditions=development electron-vite build",
    "dev": "pnpm --filter @clip-wallet/desktop-kit inpage && NODE_OPTIONS=--conditions=development electron-vite dev",
    "start": "electron .",
    "typecheck": "pnpm --filter @clip-wallet/desktop-kit inpage && tsc -p tsconfig.json --noEmit",
    "test": "echo \"apps/desktop: unit tests live in packages/desktop-kit; pnpm e2e drives this build\"",
    "e2e": "pnpm build && NODE_OPTIONS=--conditions=development playwright test",
    "dist:mac": "pnpm build && NODE_OPTIONS=--conditions=development electron-builder --mac --config electron-builder.config.cjs",
    "dist:win": "pnpm build && NODE_OPTIONS=--conditions=development electron-builder --win --config electron-builder.config.cjs",
    "dist:linux": "pnpm build && NODE_OPTIONS=--conditions=development electron-builder --linux --config electron-builder.config.cjs",
    "dist:dir": "pnpm build && NODE_OPTIONS=--conditions=development electron-builder --dir --config electron-builder.config.cjs"
  },
  "devDependencies": {
    "@clip-wallet/config": "workspace:*",
    "@clip-wallet/desktop-kit": "workspace:*",
    "@clip-wallet/engine": "workspace:*",
    "@clip-wallet/link": "workspace:*",
    "@clip-wallet/vault": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "viem": "^2.57.2",
    "vite": "^7.1.0"
  }
}
