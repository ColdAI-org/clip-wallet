{
  "name": "@clip-wallet/desktop",
  "productName": "Clip Wallet",
  "version": "0.1.0",
  "description": "Clip Wallet for macOS, Windows and Linux, with a built-in dapp browser. Test networks only.",
  "license": "MIT",
  "private": true,
  "author": "ColdAI <shayan@coldai.org>",
  "homepage": "https://coldai.org",
  "type": "module",
  "main": "out/main/index.mjs",
  "scripts": {
    "inpage": "node scripts/build-inpage.mjs",
    "build": "node scripts/build-inpage.mjs && electron-vite build",
    "dev": "node scripts/build-inpage.mjs && electron-vite dev",
    "start": "electron .",
    "typecheck": "node scripts/build-inpage.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-inpage.mjs && vitest run",
    "e2e": "pnpm build && playwright test",
    "dist:mac": "pnpm build && electron-builder --mac --config electron-builder.config.cjs",
    "dist:win": "pnpm build && electron-builder --win --config electron-builder.config.cjs",
    "dist:linux": "pnpm build && electron-builder --linux --config electron-builder.config.cjs",
    "dist:dir": "pnpm build && electron-builder --dir --config electron-builder.config.cjs"
  },
  "devDependencies": {
    "@clip-wallet/1mask": "workspace:*",
    "@clip-wallet/chains-ton": "workspace:*",
    "@clip-wallet/config": "workspace:*",
    "@clip-wallet/core": "workspace:*",
    "@clip-wallet/engine": "workspace:*",
    "@clip-wallet/features": "workspace:*",
    "@clip-wallet/hardware": "workspace:*",
    "@clip-wallet/i18n": "workspace:*",
    "@clip-wallet/security": "workspace:*",
    "@clip-wallet/social": "workspace:*",
    "@clip-wallet/ui": "workspace:*",
    "@clip-wallet/vault": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@ledgerhq/hw-transport": "^6.36.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "buffer": "^6.0.3",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "viem": "^2.57.2",
    "vitest": "^2.1.9",
    "zod": "^4.6.5"
  }
}
