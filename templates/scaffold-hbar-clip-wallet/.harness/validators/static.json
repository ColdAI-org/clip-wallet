{
  "name": "clip-wallet-typed-data-static",
  "description": "The new step lives where AGENTS.md puts dapp pages; the wallet's identity, build and testnet setting are untouched; no secrets or keys in the workspace.",
  "jsonAssertions": [
    { "file": "packages/extension/package.json", "path": "name", "equals": "@sh/extension" },
    { "file": "packages/nextjs/package.json", "path": "name", "equals": "@sh/nextjs" }
  ],
  "fileAssertions": {
    "required": [
      "AGENTS.md",
      "llms.txt",
      ".harness/spec.yaml",
      "wallet.identity.json",
      "clip.config.ts",
      "packages/extension/wxt.config.ts",
      "MAINNET.md",
      "packages/nextjs/app/page.tsx",
      "packages/nextjs/app/debug/page.tsx",
      "tools/harness/check.mjs"
    ],
    "forbidden": [".env", "packages/extension/.env.production", ".keys/extension.pem.bak"]
  },
  "textAssertions": [
    { "file": "packages/nextjs/app/page.tsx", "contains": ["useSignTypedData", "verifyTypedData", "Sign typed data"] },
    { "file": "packages/extension/wxt.config.ts", "contains": ["clipWallet({"] },
    { "file": "clip.config.ts", "contains": ["mainnet: false,"] },
    { "file": "packages/nextjs/scaffold.config.ts", "contains": ["[chains.hederaTestnet]"] }
  ]
}
