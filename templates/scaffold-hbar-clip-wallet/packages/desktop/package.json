    "directory": "templates/scaffold-hbar-clip-wallet/packages/desktop"
  },
  "type": "module",
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "check-types": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --config electron-builder.config.cjs --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs --publish never",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.config.cjs --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --config electron-builder.config.cjs --publish never"
  },
  "devDependencies": {
    "@clip-wallet/config": "0.2.0",
    "@clip-wallet/desktop-kit": "0.2.0",
