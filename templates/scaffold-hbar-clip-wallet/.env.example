# Copy to .env (never commit .env). Only CLIP_* lines are read, at build time.

# Your WalletConnect Cloud project id (32 hex characters, cloud.reown.com). Without it, "connect with a code" is off.
CLIP_WALLETCONNECT_PROJECT_ID=

# Optional partner keys. Absent = that feature says it isn't switched on.
# CLIP_0X_API_KEY=
# CLIP_JUPITER_API_KEY=
# CLIP_COINGECKO_DEMO_KEY=
# CLIP_MOONPAY_API_KEY=
# CLIP_MOONPAY_SIGNER_URL=
# CLIP_BANXA_PARTNER=
# CLIP_C14_CLIENT_ID=
# CLIP_C14_ASSET_IDS={}

# Blockaid transaction and site scanning: OFF unless set. When on, the site, the transaction and the user's address go
# to Blockaid for every request reviewed, and anyone with the extension bundle can read this key: point a proxy at it
# for production. The open phishing lists are always on and need no key.
# CLIP_BLOCKAID_API_KEY=
