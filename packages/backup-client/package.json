{
  "name": "@clip-wallet/backup-client",
  "version": "0.1.0",
  "description": "Client for the Clip Wallet passkey backup service; moves opaque encrypted blobs, never keys",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/backup-client#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/backup-client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "development": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "import": "./dist/protocol.js",
        "default": "./dist/protocol.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clip-wallet/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "~4.1.11"
  }
}
