{
  "name": "@clip-wallet/features",
  "version": "0.2.0",
  "description": "Clip Wallet features as background services: staking, swaps, on-ramps, prices, featured dapps",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/features#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/features"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./views": {
      "development": "./src/views.ts",
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js",
      "default": "./dist/views.js"
    },
    "./messages": {
      "development": "./src/messages.ts",
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js",
      "default": "./dist/messages.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./views": {
        "types": "./dist/views.d.ts",
        "import": "./dist/views.js",
        "default": "./dist/views.js"
      },
      "./messages": {
        "types": "./dist/messages.d.ts",
        "import": "./dist/messages.js",
        "default": "./dist/messages.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clip-wallet/chains-algorand": "workspace:*",
    "@clip-wallet/chains-aptos": "workspace:*",
    "@clip-wallet/chains-cardano": "workspace:*",
    "@clip-wallet/chains-hedera": "workspace:*",
    "@clip-wallet/chains-near": "workspace:*",
    "@clip-wallet/chains-solana": "workspace:*",
    "@clip-wallet/chains-starknet": "workspace:*",
    "@clip-wallet/chains-stellar": "workspace:*",
    "@clip-wallet/chains-substrate": "workspace:*",
    "@clip-wallet/chains-sui": "workspace:*",
    "@clip-wallet/chains-tezos": "workspace:*",
    "@clip-wallet/chains-ton": "workspace:*",
    "@clip-wallet/core": "workspace:*",
    "@clip-wallet/route": "workspace:*",
    "@solana-program/stake": "^0.10.0",
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.4.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hiero-ledger/sdk": "^2.89.1",
    "typescript": "^5.6.0",
    "vitest": "~4.1.11"
  }
}
