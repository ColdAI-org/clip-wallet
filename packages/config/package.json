{
  "name": "@clip-wallet/config",
  "version": "0.1.0",
  "description": "The typed clip.config.ts schema for Clip Wallet and kit-built wallets: identity, networks, routing, mainnet checklist",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "MIT",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/config"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
