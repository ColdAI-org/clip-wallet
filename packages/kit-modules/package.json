{
  "name": "@clip-wallet/kit-modules",
  "version": "0.2.0",
  "description": "Clip Wallet modules for ecosystem wallet pickers: NEAR Wallet Selector, Stellar Wallets Kit, Beacon, use-wallet",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/kit-modules#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/kit-modules"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./near": {
      "development": "./src/near/index.ts",
      "types": "./dist/near/index.d.ts",
      "import": "./dist/near/index.js",
      "default": "./dist/near/index.js"
    },
    "./stellar": {
      "development": "./src/stellar/index.ts",
      "types": "./dist/stellar/index.d.ts",
      "import": "./dist/stellar/index.js",
      "default": "./dist/stellar/index.js"
    },
    "./tezos": {
      "development": "./src/tezos/index.ts",
      "types": "./dist/tezos/index.d.ts",
      "import": "./dist/tezos/index.js",
      "default": "./dist/tezos/index.js"
    },
    "./algorand": {
      "development": "./src/algorand/index.ts",
      "types": "./dist/algorand/index.d.ts",
      "import": "./dist/algorand/index.js",
      "default": "./dist/algorand/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./near": {
        "types": "./dist/near/index.d.ts",
        "import": "./dist/near/index.js",
        "default": "./dist/near/index.js"
      },
      "./stellar": {
        "types": "./dist/stellar/index.d.ts",
        "import": "./dist/stellar/index.js",
        "default": "./dist/stellar/index.js"
      },
      "./tezos": {
        "types": "./dist/tezos/index.d.ts",
        "import": "./dist/tezos/index.js",
        "default": "./dist/tezos/index.js"
      },
      "./algorand": {
        "types": "./dist/algorand/index.d.ts",
        "import": "./dist/algorand/index.js",
        "default": "./dist/algorand/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@airgap/beacon-core": "4.8.0",
    "@airgap/beacon-types": "4.8.0",
    "@airgap/beacon-utils": "4.8.0",
    "@airgap/beacon-wallet": "4.8.1"
  },
  "peerDependencies": {
    "@near-js/crypto": "^2.3.0",
    "@near-wallet-selector/core": "^10.1.4",
    "@txnlab/use-wallet": "^5.0.1",
    "algosdk": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@near-js/crypto": {
      "optional": true
    },
    "@near-wallet-selector/core": {
      "optional": true
    },
    "@txnlab/use-wallet": {
      "optional": true
    },
    "algosdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@airgap/beacon-transport-postmessage": "4.8.0",
    "@near-js/crypto": "^2.3.0",
    "@near-wallet-selector/core": "^10.1.4",
    "@txnlab/use-wallet": "^5.0.1",
    "algosdk": "^3.8.0",
    "happy-dom": "^20.14.5",
    "@clip-wallet/1mask": "workspace:*",
    "@clip-wallet/core": "workspace:*"
  }
}
