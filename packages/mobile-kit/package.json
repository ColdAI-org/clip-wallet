{
  "name": "@clip-wallet/mobile-kit",
  "version": "0.1.0",
  "description": "Build a branded Clip Wallet phone app (Expo / React Native: iOS, Android): screens, vault host, in-app dapp browser with 1Mask, configured by clip.config.ts",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3",
    "expo",
    "react-native"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/mobile-kit#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/mobile-kit"
  },
  "type": "module",
  "sideEffects": [
    "./src/polyfills.ts",
    "./src/background/background-task.ts",
    "./dist/polyfills.js",
    "./dist/background/background-task.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./polyfills": {
      "development": "./src/polyfills.ts",
      "types": "./dist/polyfills.d.ts",
      "import": "./dist/polyfills.js",
      "default": "./dist/polyfills.js"
    },
    "./expo": {
      "development": "./src/expo.ts",
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js",
      "default": "./dist/expo.js"
    },
    "./metro": {
      "development": "./src/metro.cjs",
      "default": "./dist/metro.cjs"
    },
    "./shims/no-pbkdf2": {
      "development": "./src/shims/no-pbkdf2.js",
      "default": "./dist/shims/no-pbkdf2.js"
    },
    "./shims/node-crypto": {
      "development": "./src/shims/node-crypto.js",
      "default": "./dist/shims/node-crypto.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./polyfills": {
        "types": "./dist/polyfills.d.ts",
        "import": "./dist/polyfills.js",
        "default": "./dist/polyfills.js"
      },
      "./expo": {
        "types": "./dist/expo.d.ts",
        "import": "./dist/expo.js",
        "default": "./dist/expo.js"
      },
      "./metro": "./dist/metro.cjs",
      "./shims/no-pbkdf2": "./dist/shims/no-pbkdf2.js",
      "./shims/node-crypto": "./dist/shims/node-crypto.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-inpage.mjs && node ../../tools/release/build-package.mjs",
    "inpage": "node scripts/build-inpage.mjs",
    "typecheck": "node scripts/build-inpage.mjs && tsc -p . --noEmit",
    "test": "node scripts/build-inpage.mjs && vitest run && jest -c jest.config.cjs"
  },
  "dependencies": {
    "@clip-wallet/1mask": "workspace:*",
    "@clip-wallet/config": "workspace:*",
    "@clip-wallet/core": "workspace:*",
    "@clip-wallet/engine": "workspace:*",
    "@clip-wallet/features": "workspace:*",
    "@clip-wallet/hardware": "workspace:*",
    "@clip-wallet/i18n": "workspace:*",
    "@clip-wallet/link": "workspace:*",
    "@clip-wallet/names": "workspace:*",
    "@clip-wallet/plugins": "workspace:*",
    "@clip-wallet/security": "workspace:*",
    "@clip-wallet/social": "workspace:*",
    "@clip-wallet/ui": "workspace:*",
    "@clip-wallet/vault": "workspace:*",
    "@noble/hashes": "2.4.0",
    "pako": "2.2.0",
    "qrcode": "^1.5.4",
    "readable-stream": "^3.6.2",
    "ses": "2.3.0"
  },
  "peerDependencies": {
    "@ledgerhq/react-native-hw-transport-ble": "6.41.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@walletconnect/react-native-compat": "2.25.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-background-task": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-argon2": "4.0.0",
    "react-native-ble-plx": "3.4.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-passkey": "3.6.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@ledgerhq/react-native-hw-transport-ble": "6.41.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.0",
    "@walletconnect/react-native-compat": "2.25.0",
    "esbuild": "^0.25.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-background-task": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "happy-dom": "^20.14.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-argon2": "4.0.0",
    "react-native-ble-plx": "3.4.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-passkey": "3.6.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11"
  }
}
