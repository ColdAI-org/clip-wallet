{
  "name": "create-clip-wallet",
  "version": "0.1.0",
  "description": "Scaffold your own wallet on the Clip Wallet kit, on every platform from one clip.config.ts: browser extension, desktop app (Electron) and phone app (Expo), with its own name, ids and icons; testnet by default",
  "keywords": [
    "clip-wallet",
    "wallet",
    "scaffold-hbar",
    "hedera",
    "create",
    "template",
    "browser-extension",
    "electron",
    "expo",
    "desktop",
    "mobile"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/create-clip-wallet#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/create-clip-wallet"
  },
  "type": "module",
  "bin": {
    "create-clip-wallet": "bin/create-clip-wallet.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "template",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/bundle-template.mjs",
    "postpack": "node scripts/bundle-template.mjs --clean"
  },
  "dependencies": {
    "@clip-wallet/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0",
    "vitest": "~4.1.11"
  }
}
