{
  "name": "@clip-wallet/security",
  "version": "0.1.0",
  "description": "Clip Wallet security services: phishing lists, transaction checks, approvals review, address poisoning and hidden-token cleanup",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "MIT",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/security#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/security"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./views": {
      "development": "./src/views.ts",
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js",
      "default": "./dist/views.js"
    },
    "./messages": {
      "development": "./src/messages.ts",
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js",
      "default": "./dist/messages.js"
    },
    "./hide": {
      "development": "./src/hide.ts",
      "types": "./dist/hide.d.ts",
      "import": "./dist/hide.js",
      "default": "./dist/hide.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./views": {
        "types": "./dist/views.d.ts",
        "import": "./dist/views.js",
        "default": "./dist/views.js"
      },
      "./messages": {
        "types": "./dist/messages.d.ts",
        "import": "./dist/messages.js",
        "default": "./dist/messages.js"
      },
      "./hide": {
        "types": "./dist/hide.d.ts",
        "import": "./dist/hide.js",
        "default": "./dist/hide.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clip-wallet/chains-evm": "workspace:*",
    "@clip-wallet/chains-hedera": "workspace:*",
    "@clip-wallet/chains-solana": "workspace:*",
    "@clip-wallet/core": "workspace:*",
    "@clip-wallet/features": "workspace:*",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hiero-ledger/sdk": "^2.89.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
