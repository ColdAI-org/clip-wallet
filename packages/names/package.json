{
  "name": "@clip-wallet/names",
  "version": "0.2.0",
  "description": "Name resolution for Clip Wallet: ENS, SNS, HNS and Clip handles to an address and the network it implies",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/names#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/names"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clip-wallet/core": "workspace:*",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vitest": "~4.1.11"
  }
}
