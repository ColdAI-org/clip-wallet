{
  "name": "@clip-wallet/plugins",
  "version": "0.1.0",
  "description": "Clip Plugins: small, SES-sandboxed wallet extensions installed from npm with integrity checks",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/plugins#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/plugins"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sandbox": {
      "development": "./src/sandbox-entry.ts",
      "types": "./dist/sandbox-entry.d.ts",
      "import": "./dist/sandbox-entry.js",
      "default": "./dist/sandbox-entry.js"
    },
    "./runtime": {
      "development": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./sandbox": {
        "types": "./dist/sandbox-entry.d.ts",
        "import": "./dist/sandbox-entry.js",
        "default": "./dist/sandbox-entry.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "import": "./dist/runtime.js",
        "default": "./dist/runtime.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clip-wallet/core": "workspace:*",
    "@noble/hashes": "2.4.0",
    "ses": "2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vitest": "~4.1.11"
  }
}
