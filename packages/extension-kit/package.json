    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wxt": "^0.21.4"
  }
}
