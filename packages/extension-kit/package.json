    "@coldai/clip-wallet-chains-multiversx": "workspace:*",
    "@coldai/clip-wallet-chains-near": "workspace:*",
    "@coldai/clip-wallet-chains-solana": "workspace:*",
    "@coldai/clip-wallet-chains-stacks": "workspace:*",
    "@coldai/clip-wallet-chains-starknet": "workspace:*",
    "@coldai/clip-wallet-chains-stellar": "workspace:*",
    "@coldai/clip-wallet-chains-substrate": "workspace:*",
    "@coldai/clip-wallet-chains-sui": "workspace:*",
    "@coldai/clip-wallet-chains-tezos": "workspace:*",
    "@coldai/clip-wallet-chains-ton": "workspace:*",
    "@coldai/clip-wallet-chains-tron": "workspace:*",
    "@coldai/clip-wallet-chains-xrpl": "workspace:*",
    "@coldai/clip-wallet-config": "workspace:*",
    "@coldai/clip-wallet-core": "workspace:*",
    "@coldai/clip-wallet-engine": "workspace:*",
    "@coldai/clip-wallet-features": "workspace:*",
    "@coldai/clip-wallet-hardware": "workspace:*",
    "@coldai/clip-wallet-i18n": "workspace:*",
    "@coldai/clip-wallet-kit-modules": "workspace:*",
    "@coldai/clip-wallet-link": "workspace:*",
    "@coldai/clip-wallet-names": "workspace:*",
    "@coldai/clip-wallet-plugins": "workspace:*",
    "@coldai/clip-wallet-route": "workspace:*",
    "@coldai/clip-wallet-security": "workspace:*",
    "@coldai/clip-wallet-social": "workspace:*",
    "@coldai/clip-wallet-ui": "workspace:*",
    "@coldai/clip-wallet-vault": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "buffer": "^6.0.3",
    "viem": "^2.57.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@wxt-dev/module-react": "^1.2.0",
    "wxt": "^0.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
