{
  "name": "@coldai/clip-wallet-extension-kit",
  "version": "0.2.0",
  "description": "Build a branded Clip Wallet browser extension with WXT: background, pages, 1Mask wiring and the security floor, configured by clip.config.ts",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/extension-kit#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/extension-kit"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wxt": {
      "development": "./src/wxt.ts",
      "types": "./dist/wxt.d.ts",
      "import": "./dist/wxt.js",
      "default": "./dist/wxt.js"
    },
    "./background": {
      "development": "./src/entries/background.ts",
      "types": "./dist/entries/background.d.ts",
      "import": "./dist/entries/background.js",
      "default": "./dist/entries/background.js"
    },
    "./content": {
      "development": "./src/entries/content.ts",
      "types": "./dist/entries/content.d.ts",
      "import": "./dist/entries/content.js",
      "default": "./dist/entries/content.js"
    },
    "./inpage": {
      "development": "./src/entries/inpage.ts",
      "types": "./dist/entries/inpage.d.ts",
      "import": "./dist/entries/inpage.js",
      "default": "./dist/entries/inpage.js"
    },
    "./pages": {
      "development": "./src/entries/pages.ts",
      "types": "./dist/entries/pages.d.ts",
      "import": "./dist/entries/pages.js",
      "default": "./dist/entries/pages.js"
    },
    "./plugin-host": {
      "development": "./src/entries/plugin-host.ts",
      "types": "./dist/entries/plugin-host.d.ts",
      "import": "./dist/entries/plugin-host.js",
      "default": "./dist/entries/plugin-host.js"
    },
    "./plugin-sandbox": {
      "development": "./src/entries/plugin-sandbox.ts",
      "types": "./dist/entries/plugin-sandbox.d.ts",
      "import": "./dist/entries/plugin-sandbox.js",
      "default": "./dist/entries/plugin-sandbox.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./wxt": {
        "types": "./dist/wxt.d.ts",
        "import": "./dist/wxt.js",
        "default": "./dist/wxt.js"
      },
      "./background": {
        "types": "./dist/entries/background.d.ts",
        "import": "./dist/entries/background.js",
        "default": "./dist/entries/background.js"
      },
      "./content": {
        "types": "./dist/entries/content.d.ts",
        "import": "./dist/entries/content.js",
        "default": "./dist/entries/content.js"
      },
      "./inpage": {
        "types": "./dist/entries/inpage.d.ts",
        "import": "./dist/entries/inpage.js",
        "default": "./dist/entries/inpage.js"
      },
      "./pages": {
        "types": "./dist/entries/pages.d.ts",
        "import": "./dist/entries/pages.js",
        "default": "./dist/entries/pages.js"
      },
      "./plugin-host": {
        "types": "./dist/entries/plugin-host.d.ts",
        "import": "./dist/entries/plugin-host.js",
        "default": "./dist/entries/plugin-host.js"
      },
      "./plugin-sandbox": {
        "types": "./dist/entries/plugin-sandbox.d.ts",
        "import": "./dist/entries/plugin-sandbox.js",
        "default": "./dist/entries/plugin-sandbox.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@coldai/clip-wallet-1mask": "workspace:*",
    "@coldai/clip-wallet-backup-client": "workspace:*",
    "@coldai/clip-wallet-chains-algorand": "workspace:*",
    "@coldai/clip-wallet-chains-antelope": "workspace:*",
    "@coldai/clip-wallet-chains-aptos": "workspace:*",
    "@coldai/clip-wallet-chains-bitcoin": "workspace:*",
