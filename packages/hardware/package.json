{
  "name": "@clip-wallet/hardware",
  "version": "0.1.0",
  "description": "Hardware wallet accounts for Clip Wallet: Ledger (WebHID) and Keystone (QR); every signature is checked against what was approved",
  "keywords": [
    "clip-wallet",
    "wallet",
    "web3"
  ],
  "license": "Apache-2.0",
  "author": "ColdAI (https://coldai.org)",
  "homepage": "https://github.com/ColdAI-org/clip-wallet/tree/main/packages/hardware#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clip-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clip-wallet.git",
    "directory": "packages/hardware"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "development": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./qr": {
      "development": "./src/qr/index.ts",
      "types": "./dist/qr/index.d.ts",
      "import": "./dist/qr/index.js",
      "default": "./dist/qr/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js",
        "default": "./dist/core.js"
      },
      "./qr": {
        "types": "./dist/qr/index.d.ts",
        "import": "./dist/qr/index.js",
        "default": "./dist/qr/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../tools/release/build-package.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clip-wallet/core": "workspace:*",
    "@keystonehq/keystone-sdk": "^0.12.3",
    "@ledgerhq/hw-app-eth": "^7.9.0",
    "@ledgerhq/hw-app-solana": "^7.12.0",
    "@ledgerhq/hw-transport": "^6.36.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@ngraveio/bc-ur": "^1.1.13",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "jsqr": "^1.4.0",
    "ledger-bitcoin": "^0.3.0",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@keystonehq/bc-ur-registry": "0.8.0",
    "@keystonehq/bc-ur-registry-eth": "^0.22.1",
    "@keystonehq/bc-ur-registry-sol": "^0.9.5",
    "@ledgerhq/hw-transport-mocker": "^6.35.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
